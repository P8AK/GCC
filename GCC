/* Layout: sticky masthead + tab strip over one working canvas; every figure carries a source chip and a confidence state. */
:root{
  --bg:#F2F5F7; --surface:#FFFFFF; --ink:#101C26; --muted:#556675; --line:#D6DDE3;
  --accent:#0A6B68; --accent-ink:#FFFFFF; --accent-soft:#DCEEED;
  --warn:#8F5600; --warn-soft:#FBEBCF; --ok:#1F7A4D; --ok-soft:#DDF1E5; --bad:#B3382C;
  --f-display:'Bricolage Grotesque','IBM Plex Sans',system-ui,sans-serif;
  --f-body:'IBM Plex Sans',system-ui,-apple-system,'Segoe UI',sans-serif;
  --f-mono:'IBM Plex Mono',ui-monospace,Menlo,Consolas,monospace;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0B1218; --surface:#121C24; --ink:#E6EDF2; --muted:#92A4B2; --line:#25343F;
  --accent:#4FC3BD; --accent-ink:#06201F; --accent-soft:#12302F;
  --warn:#E6A93E; --warn-soft:#38290E; --ok:#5CC28C; --ok-soft:#10301F; --bad:#E57A6E; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0B1218; --surface:#121C24; --ink:#E6EDF2; --muted:#92A4B2; --line:#25343F;
  --accent:#4FC3BD; --accent-ink:#06201F; --accent-soft:#12302F;
  --warn:#E6A93E; --warn-soft:#38290E; --ok:#5CC28C; --ok-soft:#10301F; --bad:#E57A6E; color-scheme:dark}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--ink);font:400 15px/1.55 var(--f-body);padding-inline:16px}
.wrap{max-width:1120px;margin-inline:auto}
header.mast{display:flex;flex-wrap:wrap;align-items:baseline;gap:6px 20px;padding-block:20px 8px}
.brand{font:700 26px/1 var(--f-display);letter-spacing:-.02em}
.brand i{font-style:normal;color:var(--accent)}
.tag{color:var(--muted);flex:1 1 280px;min-width:0}
.stamp{font:500 11px var(--f-mono);letter-spacing:.04em;text-transform:uppercase;color:var(--muted);border:1px solid var(--line);border-radius:4px;padding:3px 7px;background:var(--surface)}
nav.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;background:var(--bg);display:flex;gap:2px;overflow-x:auto;border-bottom:1px solid var(--line);margin-inline:-16px;padding-inline:16px}
nav.tabs button{flex:none;font:500 14px var(--f-body);color:var(--muted);background:none;border:0;border-bottom:2px solid transparent;padding:12px 12px 10px;cursor:pointer}
nav.tabs button:hover{color:var(--ink)}
nav.tabs button[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent)}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
main{padding-block:24px 56px;display:grid;gap:28px}
h1,h2,h3{font-family:var(--f-display);letter-spacing:-.015em;text-wrap:balance;margin:0}
h2{font-size:24px;line-height:1.2}
h3{font-size:16px}
.lede{color:var(--muted);max-width:68ch;margin:6px 0 0}
.panel{background:var(--surface);border:1px solid var(--line);border-radius:8px;padding:18px}
.grid2{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,320px),1fr));gap:16px}
.mono{font-family:var(--f-mono);font-variant-numeric:tabular-nums}
.muted{color:var(--muted)}
.src{display:inline-block;font:500 10.5px var(--f-mono);color:var(--accent);background:var(--accent-soft);border-radius:3px;padding:1px 5px;text-decoration:none;vertical-align:1px;margin-left:3px}
.chip{display:inline-block;font:500 11px var(--f-body);border-radius:999px;padding:2px 9px;border:1px solid var(--line);color:var(--muted);white-space:nowrap}
.chip.warn{background:var(--warn-soft);color:var(--warn);border-color:transparent}
.chip.ok{background:var(--ok-soft);color:var(--ok);border-color:transparent}
.chip.acc{background:var(--accent-soft);color:var(--accent);border-color:transparent}
.btn{font:500 13px var(--f-body);border:1px solid var(--line);background:var(--surface);color:var(--ink);border-radius:6px;padding:7px 12px;cursor:pointer}
.btn:hover{border-color:var(--accent)}
.btn.primary{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn[aria-pressed="true"]{background:var(--accent-soft);color:var(--accent);border-color:var(--accent)}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.tablewrap{overflow-x:auto;border:1px solid var(--line);border-radius:8px;background:var(--surface)}
table{border-collapse:collapse;width:100%;font-size:14px}
th,td{text-align:left;padding:10px 12px;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child td{border-bottom:0}
th{font:500 11px var(--f-mono);text-transform:uppercase;letter-spacing:.06em;color:var(--muted);white-space:nowrap;background:var(--surface)}
th button{all:unset;cursor:pointer}
th button:hover{color:var(--ink)}
td.num,th.num{text-align:right;font-variant-numeric:tabular-nums;font-family:var(--f-mono)}
.na{color:var(--muted);opacity:.7}
/* bars */
.bars{display:grid;gap:8px}
.bar{display:grid;grid-template-columns:minmax(0,230px) minmax(0,1fr) 64px;gap:12px;align-items:center;background:none;border:0;text-align:left;color:inherit;font:inherit;padding:6px 8px;border-radius:6px;cursor:pointer;width:100%}
.bar:hover,.bar[aria-pressed="true"]{background:var(--accent-soft)}
.bar .lab{font-size:13px;line-height:1.3;min-width:0}
.bar .lab small{display:block;color:var(--muted);font-size:11.5px}
.track{height:14px;background:var(--bg);border-radius:3px;overflow:hidden}
.fill{height:100%;background:var(--accent);border-radius:3px}
.fill.alt{background:var(--muted);opacity:.55}
.bar .val{font:500 13px var(--f-mono);text-align:right}
@media (max-width:620px){.bar{grid-template-columns:1fr 56px}.bar .track{grid-column:1 / -1;order:3}}
/* conflict ledger */
.conf{display:grid;gap:12px}
.conf article{border:1px solid var(--line);border-left:3px solid var(--warn);border-radius:6px;background:var(--surface);padding:14px 16px;display:grid;gap:8px}
.conf .vals{display:flex;flex-wrap:wrap;gap:8px}
.conf .vals span{font:500 13px var(--f-mono);background:var(--warn-soft);color:var(--warn);border-radius:4px;padding:3px 8px}
.treat{font-size:13.5px;color:var(--muted)}
.treat b{color:var(--ink);font-weight:600}
/* fit finder */
.sliders{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:14px 22px}
.sl label{display:flex;justify-content:space-between;font-size:13px;margin-bottom:4px}
.sl input[type=range]{width:100%;accent-color:var(--accent)}
.rank{display:grid;gap:10px;margin-top:6px}
.rk{display:grid;grid-template-columns:28px minmax(0,1fr);gap:12px;align-items:start;padding:10px 0;border-top:1px solid var(--line)}
.rk:first-child{border-top:0}
.rk .n{font:700 20px var(--f-display);color:var(--accent)}
.rk .meter{height:8px;background:var(--bg);border-radius:3px;margin:6px 0;overflow:hidden}
.rk .meter div{height:100%;background:var(--accent)}
.rk p{margin:0;font-size:13.5px;color:var(--muted)}
select,input[type=text],textarea{font:inherit;color:var(--ink);background:var(--surface);border:1px solid var(--line);border-radius:6px;padding:8px 10px;max-width:100%}
textarea{width:100%;min-height:76px;resize:vertical}
.cover{font:500 12px var(--f-mono);color:var(--muted)}
.cover b{color:var(--accent)}
details{border-top:1px solid var(--line);padding-top:10px;margin-top:12px}
summary{cursor:pointer;font-weight:500}
.model{display:grid;gap:6px}
.model.pick{border-color:var(--accent);box-shadow:0 0 0 1px var(--accent) inset}
.kv{display:grid;grid-template-columns:110px minmax(0,1fr);gap:4px 12px;font-size:13.5px}
.kv dt{color:var(--muted)}.kv dd{margin:0}
.answer{white-space:pre-wrap;line-height:1.6;font-size:14.5px}
.pillrow{display:flex;flex-wrap:wrap;gap:8px}
.chain{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,210px),1fr));gap:12px}
.chain .panel{padding:14px}
.chain h3{margin-bottom:4px}
.chain p{margin:0;font-size:13.5px;color:var(--muted)}
.srcitem{display:grid;grid-template-columns:44px minmax(0,1fr);gap:10px;padding:10px 0;border-bottom:1px solid var(--line)}
.srcitem:target,.srcitem.hl{background:var(--accent-soft)}
.srcitem a{color:var(--accent);word-break:break-word}
@media (prefers-reduced-motion: no-preference){.fill,.rk .meter div{transition:width .35s ease}}
</style>

