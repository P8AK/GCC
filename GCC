  '<section class="panel"><h3>How a provider earns a score</h3><dl class="kv" style="margin-top:10px"><dt>Verified</dt><dd>Engagement confirmed by two independent signals (filing, lease, job postings, client reference).</dd><dt>Delivered</dt><dd>Headcount and time to first hire at 6 and 12 months against the announced plan.</dd><dt>Referenced</dt><dd>Client-confirmed outcome, with the client\'s role named. Clients can reply to disputes.</dd></dl><p class="muted" style="margin:10px 0 0">No provider score is published yet: two press-only rows are not enough to rank anyone, and showing a score here would be invented.</p></section>';
}
function vAsk(){
  var qs=["Compare Hyderabad and Pune for a 150-person engineering centre.","Which states have a notified GCC policy and what do they target?","Why do the GCC counts differ across reports?","I need a first hire within a month and expect 20 people. What route do I take?"];
  return '<section><h2>Ask Atlas</h2><p class="lede">Ask Atlas is grounded in the sample dataset. In a standalone browser this demo uses a small local response layer; the Claude-connected version can use a model. Either way, unknown figures should stay unknown.</p></section>'+
  '<section class="panel"><div class="pillrow" style="margin-bottom:12px">'+qs.map(function(q,i){return '<button class="btn" data-q="'+i+'">'+esc(q)+'</button>'}).join('')+'</div><label for="q" class="muted" style="font-size:13px">Your question</label><textarea id="q" placeholder="For example: where can I find the lowest attrition for a 60-person analytics team?"></textarea><div class="row" style="margin-top:10px"><button class="btn primary" id="go">Ask</button><button class="btn" id="stop" hidden>Stop</button><span class="muted" id="askstat"></span></div><div class="answer" id="ans" style="margin-top:16px" aria-live="polite"></div></section>';
}
function vSources(){
  var items=Object.keys(SOURCES).map(function(k){var s=SOURCES[k];return '<div class="srcitem" id="src-'+k+'"><span class="src mono" style="height:fit-content;text-align:center">'+k+'</span><div><div>'+esc(s.n)+'</div><div class="muted" style="font-size:12.5px">'+esc(s.d)+' · <a href="'+esc(s.u)+'" target="_blank" rel="noopener">'+esc(s.u.replace(/^https?:\/\//,'').slice(0,70))+'</a></div></div></div>'}).join('');
  return '<section><h2>Sources</h2><p class="lede">'+Object.keys(SOURCES).length+' public sources behind this prototype. Several are trade press or vendor pages that quote primary reports, which is why Atlas tracks the basis of each figure.</p></section><section class="panel">'+items+'</section>';
}

/* ---------- Ask: grounded call to Claude through the sample capability ---------- */
var askAbort=null;
function context(){
  return JSON.stringify({sources:Object.keys(SOURCES).reduce(function(o,k){o[k]=SOURCES[k].n+" ("+SOURCES[k].d+")";return o},{}),counts:COUNTS,conflicts:CONFLICTS,cities:CITIES.map(function(c){return {city:c.c,tier:c.tier,gccs:c.gccs,hiringSharePct:c.hire,newGCCsFY25:c.newFY25,rentInrSqftMonth:c.rent,attrition:c.attr,index:c.ix,reasons:c.why,sources:c.s}}),states:STATES,entryRoutes:MODELS,pipeline:SIGNALS});
}

function localAskAnswer(question){
  var q=String(question||"").toLowerCase();
  if(/count|how many|number|differ|conflict|disagree/.test(q)){
    return "The cleanest FY26 company-level figure in this dataset is 2,117 GCCs, across 3,728 individual sites [S1]. The other published values use different years or counting bases: FY24 is 1,800, Zinnov’s end-2025 figure is 1,760, and the 2025 secondary figure is 1,700 [S18] [S20] [S19]. I would not average these together. Atlas keeps the reporting period and definition alongside each number.\n\nGap: a company-level master list reconciled against the primary datasets would make the count more defensible."
  }
  if(/hyderabad|pune|city|location|where.*build|compare/.test(q)){
    return "For this sample, Hyderabad has a reported 515+ GCCs and a directional Atlas momentum score of 90; Pune has 475+ GCCs and a momentum score of 75 [S9] [S5]. The Hyderabad rent input is about ₹75/sq ft/month, while Pune rent is not yet sourced. These scores are an analyst index, not a measured market ranking. I would treat Hyderabad as the stronger initial hypothesis for growth and leave a final recommendation open until costs and role-specific talent are compared on a like-for-like basis.\n\nGap: comparable Grade A rents, role-level salary bands and independently sourced attrition data for both cities."
  }
  if(/state|policy|incentive|subsid/.test(q)){
    var active=STATES.filter(function(s){return s.status==="In force"}).map(function(s){return s.st+" ("+s.pol+")"}).slice(0,7).join(", ");
    return "In the current sample, states marked as having a policy in force include "+active+" [S2] [S10] [S11]. The dataset separately labels frameworks, incentives-only entries and draft policies, because those are not equivalent to a notified policy. Maharashtra’s target is flagged because sources disagree; the primary policy should decide which figure Atlas ultimately publishes [S2] [S11].\n\nGap: the latest notified policy text for every state and a structured, comparable schedule of eligibility, caps, exclusions and application steps."
  }
  if(/route|first hire|hire within|people|eor|bot|own entity|entry model/.test(q)){
    return "For a team of around 20 people that needs to hire quickly, an Employer of Record is the starting option in this sample: vendor material suggests hiring can begin in about 1–2 weeks, with low setup overhead [S13] [S14]. That is not a legal or tax recommendation. Before choosing it, confirm the role types, expected duration, IP needs, tax position and the point at which an Indian subsidiary becomes preferable. The source timelines are vendor estimates, not verified Atlas outcomes.\n\nGap: verified time-to-first-hire and total cost data from completed engagements, plus legal review for the company’s specific operating model."
  }
  if(/pipeline|next|coming|signal|announc|lead/.test(q)){
    return "The current sample contains public announcements and expansions only. It does not yet identify companies before a GCC announcement, so it cannot prove the pre-launch radar thesis. The next version would join MCA filings, leadership job postings, state approvals, lease evidence and provider confirmations, then show which signals support each lead [S15] [S16] [S17] [S24].\n\nGap: a back-tested history of early signals and launches, plus provider interviews to establish how much earlier a useful lead arrives."
  }
  if(/provider|partner|deliver|evidence/.test(q)){
    return "The provider ledger currently has two press-sourced engagements. Both are marked announced, and delivered headcount is still pending. That is not enough evidence to rank providers, so Atlas should publish the engagements and their sources but hold off on scores. Later verification could compare planned versus delivered headcount, time to first hire and client-confirmed outcomes.\n\nGap: provider participation and independent confirmation from clients or filings."
  }
  return "I can answer a few questions from the current sample: GCC counts and their differences, Hyderabad versus Pune, state policies, entry routes, public pipeline signals, and provider evidence. This standalone demo does not search the live web.\n\nGap: ask a narrower question or connect a model-backed endpoint for broader natural-language analysis."
}

async function ask(text){
  var ans=$("#ans"),stat=$("#askstat"),go=$("#go"),stop=$("#stop");
  if(!text.trim())return;
  var sample=null;
  try{sample=window.claude&&window.claude.use?await window.claude.use("sample"):null}catch(e){}
  if(!sample){ans.textContent=localAskAnswer(text);stat.textContent="Local demo response · no live model call";return}
  askAbort=new AbortController();go.disabled=true;stop.hidden=false;stat.textContent="Thinking";ans.textContent="";
  var system="You are the analyst inside GCC Atlas, a data product about Global Capability Centres in India. Answer ONLY from the DATA below. Cite sources inline as [S#] using the ids in DATA. If DATA lacks a figure (a null or missing value), say it is not yet sourced and do not estimate. When DATA contains conflicting figures for the same fact, state both and say they conflict. The city 'index' values are an Atlas v0 analyst index, directional only, so label them that way. Be concise: under 220 words, plain prose with at most one short list. End with one line starting 'Gap:' naming what data would make the answer firmer.\n\nDATA:\n"+context()+"\n\nQUESTION:\n"+text;
  try{
    await sample(system,{signal:askAbort.signal,cache:false,modelTier:"quick",onText:function(t){ans.textContent=t.text;stat.textContent=""}});
    stat.textContent="";
  }catch(e){
    if(e&&e.code==="not_granted"){ans.textContent=localAskAnswer(text);stat.textContent="Local demo response · model permission unavailable";}
    else if(e&&e.code==="rate_limited"){ans.textContent=localAskAnswer(text);stat.textContent="Local demo response · model rate-limited";}
    else if(!(askAbort&&askAbort.signal.aborted)){ans.textContent=localAskAnswer(text);stat.textContent="Local demo response · model connection unavailable";}
    stat.textContent="";
  }finally{go.disabled=false;stop.hidden=true;askAbort=null}
}

/* ---------- routing ---------- */
var VIEWS={truth:vTruth,registry:vRegistry,cities:vCities,states:vStates,entry:vEntry,signals:vSignals,providers:vProviders,ask:vAsk,sources:vSources};
function renderTabs(){
  $("#tabs").innerHTML=TABS.map(function(t){return '<button role="tab" data-tab="'+t[0]+'" aria-selected="'+(state.tab===t[0])+'">'+t[1]+'</button>'}).join('');
}
function render(){renderTabs();$("#view").innerHTML=VIEWS[state.tab]();
  if(state.tab==="sources"&&state.hl){var e=document.getElementById("src-"+state.hl);if(e){e.classList.add("hl");e.scrollIntoView({block:"center"})}state.hl=null}
}
function go(tab){state.tab=tab;try{if(location.hash!=="#"+tab)history.replaceState(null,"","#"+tab)}catch(e){}render();window.scrollTo(0,0)}
document.addEventListener("click",function(e){
  var t=e.target.closest("[data-tab],[data-src],[data-sort],[data-i],[data-stf],[data-sc],[data-q],#go,#stop");if(!t)return;
  if(t.dataset.tab){go(t.dataset.tab)}
  else if(t.dataset.src){e.preventDefault();state.hl=t.dataset.src;go("sources")}
  else if(t.dataset.sort){var k=t.dataset.sort;if(k==="c"){state.dir=state.sort===k?-state.dir:1}else{state.dir=state.sort===k?-state.dir:-1}state.sort=k;render()}
  else if(t.dataset.i!==undefined){state.countSel=+t.dataset.i;render()}
  else if(t.dataset.stf){state.stFilter=t.dataset.stf;render()}
  else if(t.dataset.sc){state.sigCity=t.dataset.sc;render()}
  else if(t.dataset.q!==undefined){var qs=["Compare Hyderabad and Pune for a 150-person engineering centre.","Which states have a notified GCC policy and what do they target?","Why do the GCC counts differ across reports?","I need a first hire within a month and expect 20 people. What route do I take?"];$("#q").value=qs[+t.dataset.q];ask(qs[+t.dataset.q])}
  else if(t.id==="go"){ask($("#q").value)}
  else if(t.id==="stop"){if(askAbort)askAbort.abort()}
});
document.addEventListener("input",function(e){
  var t=e.target;
  if(t.id==="registry-search"){
    var q=t.value.trim().toLowerCase(),visible=0;
    document.querySelectorAll("[data-reg-row]").forEach(function(r){var show=!q||r.dataset.company.indexOf(q)!==-1;r.hidden=!show;if(show)visible++});
    var empty=document.getElementById("registry-empty");if(empty)empty.hidden=visible!==0;
  }
  else if(t.dataset&&t.dataset.w){state.w[t.dataset.w]=+t.value;$("#wv-"+t.dataset.w).textContent=t.value;$("#rank").innerHTML=fitHTML()}
  else if(t.id==="head"){state.head=+t.value;$("#headv").textContent=t.value;$("#models").innerHTML=MODELS.map(modelCard).join("")}
});
document.addEventListener("change",function(e){
  var t=e.target;
  if(t.id==="size"){state.size=t.value;$("#rank").innerHTML=fitHTML()}
  else if(t.id==="urgent"){state.urgent=t.value;$("#models").innerHTML=MODELS.map(modelCard).join("")}
  else if(t.id==="control"){state.control=t.value;$("#models").innerHTML=MODELS.map(modelCard).join("")}
});
function modelCard(m){var rid=recommend();return '<div class="panel model'+(m.id===rid?' pick':'')+'"><div class="row" style="justify-content:space-between"><h3>'+m.n+'</h3>'+(m.id===rid?'<span class="chip acc">Best fit for your inputs</span>':'')+'</div><dl class="kv"><dt>Time</dt><dd>'+esc(m.time)+'</dd><dt>Cost</dt><dd>'+esc(m.cost)+'</dd><dt>Fits when</dt><dd>'+esc(m.fit)+'</dd><dt>Watch for</dt><dd>'+esc(m.risk)+'</dd></dl><div>'+chips(m.s)+'</div></div>'}
window.addEventListener("hashchange",function(){var h=location.hash.slice(1);if(VIEWS[h]&&h!==state.tab){state.tab=h;render()}});
(function(){var h=location.hash.slice(1);if(VIEWS[h])state.tab=h;render()})();
</script>

